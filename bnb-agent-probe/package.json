{
  "name": "bnb-agent-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run manifest:check && npm test && npm run dry-run && npm run dry-run:staging && npm run dry-run:validation",
    "migrate:local": "wrangler d1 migrations apply bnb-agent-probe --local",
    "migrations:list:local": "wrangler d1 migrations list bnb-agent-probe --local",
    "d1:export:staging": "mkdir -p ../evidence/raw && wrangler d1 export bnb-agent-probe-staging --remote --env staging --output ../evidence/raw/d1-staging-$(date -u +%Y%m%dT%H%M%SZ).sql",
    "dry-run": "wrangler deploy --dry-run --env=\"\" --outdir dist/worker",
    "dry-run:staging": "wrangler deploy --dry-run --env staging --outdir dist/worker-staging",
    "dry-run:validation": "wrangler deploy --dry-run --env validation --outdir dist/worker-validation",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "manifest:check": "tsx scripts/generate-curated-inventory.ts",
    "evidence:wp2-24h": "tsx scripts/validate-wp2-24h.ts",
    "evidence:wp2-build": "tsx scripts/build-wp2-artifact.ts",
    "evidence:wp2-analytics": "tsx scripts/capture-wp2-analytics.ts",
    "evidence:wp2-ledger": "tsx scripts/capture-wp2-ledger.ts",
    "evidence:wp2-control": "tsx scripts/capture-wp2-control.ts",
    "evidence:wp2-deployment": "tsx scripts/capture-wp2-deployment.ts",
    "evidence:wp2-window-start": "tsx scripts/capture-wp2-window-start.ts",
    "rollback:wp2-activation": "tsx scripts/rollback-wp2-activation.ts",
    "rpc:probe": "tsx scripts/rpc-logs-probe.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.0",
    "drizzle-orm": "0.45.2",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.1",
    "@types/node": "22.17.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.127.0"
  }
}
