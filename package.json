{
  "name": "bnb-agent-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "marketplace": "dist/src/marketplace-cli-bin.js",
    "marketplace-mcp": "dist/src/marketplace-mcp-bin.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "build": "npm run build:cli && npm run build:web",
    "build:deployment": "npm run readiness:bsc && npm run build",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "next build --webpack",
    "check": "npm run typecheck && npm test && npm run build",
    "gate1": "tsx src/cli.ts",
    "gate1:seller": "tsx src/seller.ts",
    "hosted-seller:register": "node --env-file=.env.local --import tsx src/hosted-seller-cli.ts register",
    "inventory:bsc": "tsx src/trust8004/inventory-cli.ts",
    "snapshot:funnel:bsc": "tsx src/trust8004/funnel-snapshot-cli.ts",
    "snapshot:catalog:bsc": "tsx src/trust8004/catalog-snapshot-cli.ts",
    "seed:catalog:d1": "sh -c 'if [ -f .env.local ]; then node --env-file=.env.local --import tsx src/trust8004/catalog-d1-seed-cli.ts \"$@\"; else tsx src/trust8004/catalog-d1-seed-cli.ts \"$@\"; fi' --",
    "marketplace": "tsx src/marketplace-cli-bin.ts",
    "mcp": "tsx src/marketplace-mcp-bin.ts",
    "verify:bsc": "tsx src/verification/cli.ts",
    "publish:verification": "tsx src/verification/publish-cli.ts",
    "check:verification-snapshot": "tsx src/verification/check-public-snapshot-cli.ts",
    "mainnet:go-no-go": "node --env-file=.env.local --import tsx src/mainnet/go-no-go-cli.ts",
    "mainnet:grid-seller": "node --conditions=react-server --env-file=.env.local --import tsx src/mainnet/grid-seller-cli.ts",
    "mainnet:settle-grid-job": "node --conditions=react-server --env-file=.env.local --import tsx src/mainnet/settle-grid-job-cli.ts",
    "mainnet:capture-proof": "node --env-file=.env.local --import tsx src/mainnet/capture-job-proof-cli.ts",
    "readiness:bsc": "if [ -f .env.local ]; then node --env-file=.env.local --import tsx src/readiness/cli.ts; else tsx src/readiness/cli.ts; fi",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tanstack/react-query": "5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "nextjs-toploader": "^3.9.17",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "6.28.0",
    "viem": "2.55.13",
    "wagmi": "3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.17.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
