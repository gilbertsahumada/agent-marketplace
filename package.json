{
  "name": "bnb-agent-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "gate1": "tsx src/cli.ts",
    "gate1:seller": "tsx src/seller.ts",
    "inventory:bsc": "tsx src/trust8004/inventory-cli.ts",
    "verify:bsc": "tsx src/verification/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.0",
    "@modelcontextprotocol/client": "2.0.0",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
