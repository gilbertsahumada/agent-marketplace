# Public, non-secret Gate 1 configuration only.
NETWORK=bsc-testnet
AGENT_ID=123
BUYER_ADDRESS=0x0000000000000000000000000000000000000000
# BUYER_WALLET_PASSWORD is required only for --execute. Inject it through an
# external secret mechanism; never save it in this file.
# BUYER_WALLETS_DIR=/absolute/path/to/encrypted-wallets

# Optional read endpoint. It must serve BSC Testnet chain ID 97.
# RPC_URL_BSC_TESTNET=https://data-seed-prebsc-2-s2.binance.org:8545

# Optional seller bearer token. Supply through an external secret mechanism;
# never commit it to this file or any receipt.
# AGENT_BEARER_TOKEN=

# Optional runtime controls.
# GATE1_POLL_INTERVAL_MS=15000
# GATE1_SUBMITTED_TIMEOUT_MS=1200000
# GATE1_RECEIPT_DIR=.gate1/receipts

# Controlled seller fixture. SELLER_WALLET_PASSWORD is required at runtime
# through an external secret mechanism and is intentionally not stored here.
# The address must already have an encrypted @bnbagent/sdk keystore.
# SELLER_ADDRESS=0x0000000000000000000000000000000000000000
# A2A_BASE_URL=https://temporary-tunnel.example
# SELLER_PORT=8010
# ERC8183_SERVICE_PRICE=1
# SELLER_STORAGE_DIR=.gate1/seller-data
# Gate 6A browser-wallet spike. Disabled unless explicitly enabled.
ERC8183_BROWSER_SPIKE_ENABLED=false
# Bare HTTPS origin registered for controlled Testnet Agent 1866.
ERC8183_BROWSER_SPIKE_SELLER_ORIGIN=
# Optional server-only A2A credential. Never prefix with NEXT_PUBLIC_.
ERC8183_BROWSER_SPIKE_BEARER_TOKEN=
# Hosted Testnet seller. Sensitive Production-only Vercel secret; Preview calls
# the fixed Production seller and never receives this value. This deployment
# intentionally reuses the same key value in MAINNET_SELLER_PRIVATE_KEY while
# retaining separate variable names to preserve the Testnet/Mainnet boundary.
SELLER_PRIVATE_KEY=

# Gated BSC Mainnet Grid seller. Seller enables Agent Card and quote readiness;
# writes remain separately disabled until a fresh go/no-go result passes.
ERC8183_MAINNET_SELLER_ENABLED=false
ERC8183_MAINNET_DEMO_ENABLED=false
ERC8183_MAINNET_WRITES_ENABLED=false
ERC8183_MAINNET_SELLER_ORIGIN=https://bnb-agent-marketplace-ruby.vercel.app
ERC8183_MAINNET_SELLER_ADDRESS=
ERC8183_MAINNET_SELLER_AGENT_ID=
ON_DEMAND_QUOTE_TIMEOUT_MS=30000
QUOTE_MIN_REMAINING_SECONDS=120
# Sensitive Production-only Vercel secret. For this deployment, repeat the
# SELLER_PRIVATE_KEY value here; do not reference one variable from the other.
# Never scope it to Preview/Development, prefix it with NEXT_PUBLIC_, print it,
# or commit a value.
MAINNET_SELLER_PRIVATE_KEY=

# Cloudflare observation Worker. Free is the safe default; changing to paid is
# an explicit operational decision and does not disable the kill switch.
# Server-side public Worker feed, for example https://worker.example/observations.
# It also supplies the origin used for the public catalog and authenticated evidence writes.
OBSERVATIONS_URL=
# Exact Worker HTTPS origin (scheme + host only); this is an outbound allowlist, not browser CORS.
# Paths, userinfo and origin mismatches fail closed before the bearer secret can be sent.
BUYER_OBSERVATION_ALLOWED_ORIGIN=
# Dedicated bearer secret shared only by the Vercel server and Worker.
# Never prefix it with NEXT_PUBLIC_ or reuse the administrative SHARED_SECRET.
BUYER_OBSERVATION_SECRET=

# Concierge (plain-language hiring assistant). Active only when CONCIERGE_API_KEY is set.
# CONCIERGE_BASE_URL: OpenAI-compatible endpoint. DashScope international: https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (China region: https://dashscope.aliyuncs.com/compatible-mode/v1). DeepSeek: https://api.deepseek.com/v1
# CONCIERGE_MODEL: qwen-plus (default). DeepSeek: deepseek-chat. Open-source Qwen3 models need thinking disabled and are not supported by the default client.
# CONCIERGE_DAILY_CAP: global requests per UTC day per instance (default 300).
CONCIERGE_BASE_URL=
CONCIERGE_API_KEY=
CONCIERGE_MODEL=
CONCIERGE_DAILY_CAP=

CLOUDFLARE_WORKERS_PLAN=free
KILL_SWITCH=1
# Free profile defaults: one phase per invocation, every five minutes.
CRON_INTERVAL_MINUTES=5
HEADER_LIMIT=25
SWEEP_LIMIT=4
SWEEP_PAGES_PER_RUN=1
PROBE_BATCH_SIZE=1
PROBE_AGENT_ALLOWLIST=303779
PROBE_ENDPOINT_ALLOWLIST=https://bnb-agent-marketplace-ruby.vercel.app/grid
PROBE_GENERAL_EGRESS_APPROVED=0
TRUST8004_REQUESTS_PER_RUN=4
EXTERNAL_SUBREQUESTS_PER_RUN=12
D1_QUERIES_PER_RUN=40
D1_ROWS_READ_PER_RUN=3000
D1_ROWS_WRITTEN_PER_RUN=60
PROBE_TIMEOUT_MS=5000
MAX_CATALOG_RESPONSE_BYTES=16777216
MAX_SELLER_RESPONSE_BYTES=32768
