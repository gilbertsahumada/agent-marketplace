# Public, non-secret Gate 1 configuration only.
NETWORK=bsc-testnet
AGENT_ID=123
BUYER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional read endpoint. It must serve BSC Testnet chain ID 97.
# RPC_URL_BSC_TESTNET=https://data-seed-prebsc-2-s2.binance.org:8545

# Optional seller bearer token. Supply through an external secret mechanism;
# never commit it to this file or any receipt.
# AGENT_BEARER_TOKEN=

# Optional runtime controls.
# GATE1_POLL_INTERVAL_MS=15000
# GATE1_SUBMITTED_TIMEOUT_MS=1200000
# GATE1_RECEIPT_DIR=.gate1/receipts
